#!/bin/sh
# 所有时机复用同一维护入口；只改 dev 的本地 tag，绝不隐式推送。
phase=${1:-post-commit}

fail_maintenance() {
    if [ "$phase" = pre-push ]; then
        printf '%s\n' '版本标签维护失败，已阻止本次推送；请先解决上面的错误。' >&2
        exit 1
    fi
    printf '%s\n' \
        'Git 操作已完成，但本地版本标签维护失败；已完成的操作没有被撤销。' \
        '请处理以上错误后运行 cargo xtask version-tags --apply 补齐，标签不会自动推送。' >&2
    exit 0
}

branch=$(git symbolic-ref --quiet HEAD)
status=$?
if [ "$status" -eq 1 ]; then
    exit 0
fi
if [ "$status" -ne 0 ]; then
    fail_maintenance
fi
if [ "$branch" != refs/heads/dev ]; then
    exit 0
fi

root=$(git rev-parse --show-toplevel)
if [ "$?" -ne 0 ]; then
    fail_maintenance
fi

if ! (
    cd "$root" &&
    cargo run --offline --locked --package xtask -- version-tags --apply --repo "$root"
); then
    fail_maintenance
fi
exit 0
