<?xml version="1.0" encoding="UTF-8"?>
<Page>
  <Import src="./publish.kenvoy.xml" as="权限配置" />
  <Title>通讯录</Title>
  <Content>
    <Section title="人员通讯录">
      <Text value="user_id 为空 = 无账号人员（人事场景：入职但暂无系统账号）。" />
      <Table model="__contacts" source="contacts" pageSize="50">
        <Column field="id" label="ID" width="64" />
        <Column field="name" label="姓名" />
        <Column field="title" label="职务" />
        <Column field="email" label="邮箱" />
        <Column field="phone" label="电话" />
        <Column field="department_id" label="部门 ID" />
        <Column field="user_id" label="账号 ID" />
        <Column field="status" label="状态" />
      </Table>
    </Section>
  </Content>
</Page>