<?xml version="1.0" encoding="UTF-8"?>
<Page>
  <Import src="./publish.kenvoy.xml" as="权限配置" />
  <Title>角色管理</Title>
  <Content>
    <Section title="角色定义">
      <Text value="角色等级决定账号等级（账号取所有角色最高级）。角色新增/改级用 `kv role add --name --level`。" />
      <Table model="__roles" source="roles" pageSize="50">
        <Column field="id" label="ID" width="64" />
        <Column field="name" label="角色名" />
        <Column field="level" label="等级" width="64" />
        <Column field="description" label="描述" />
      </Table>
    </Section>
  </Content>
</Page>