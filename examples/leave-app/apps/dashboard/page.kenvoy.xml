<?xml version="1.0" encoding="UTF-8"?>
<Page>
  <Title>工作台</Title>
  <!-- 页面私有自定义组件：props 绑定 {{title}}，实例子元素注入 <Slot/> -->
  <Component name="进度卡">
    <Section title="{{title}}">
      <Slot />
    </Section>
  </Component>
  <Content>
    <Row>
      <Col span="4">
        <StatCard data="统计(请假单.数量)" unit="次" color="blue" />
      </Col>
      <Col span="4">
        <StatCard data="统计(请假单.数量)" unit="次" color="orange" />
      </Col>
      <Col span="4">
        <StatCard data="统计(请假单.数量)" unit="%" color="green" />
      </Col>
    </Row>
    <Row>
      <Col span="8">
        <Section title="请假类型分布">
          <!-- 柱状图：运行时按模型字段分组统计渲染 -->
          <Chart model="请假单" field="请假类型" stat="count" />
        </Section>
      </Col>
      <Col span="4">
        <进度卡 title="审批进度">
          <Text value="待我审批：2 单" />
        </进度卡>
      </Col>
    </Row>
    <Row>
      <Col span="12">
        <Section title="请假审批流程">
          <FlowViewer flow="请假审批流" />
        </Section>
      </Col>
    </Row>
  </Content>
</Page>