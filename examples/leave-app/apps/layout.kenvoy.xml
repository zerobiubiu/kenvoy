<?xml version="1.0" encoding="UTF-8"?>
<Layout>
  <Title>Kenvoy 演示</Title>
  <Root>
    <!-- 顶部导航：brand + 应用入口；登录态徽章由 runtime.js 注入 -->
    <Section kind="navbar" title="Kenvoy 请假管理平台">
      <Button value="工作台" kind="link" size="sm" action="navigate" href="/dashboard" />
      <Button value="提交请假" kind="link" size="sm" action="navigate" href="/leave/apply" />
      <Button value="审批列表" kind="link" size="sm" action="navigate" href="/leave/list" />
      <!-- 应用级权限：按账号角色/等级过滤（runtime.js 读取 data-roles / data-min-level） -->
      <Button value="人事中心" kind="link" size="sm" action="navigate" href="/hr/contacts" data-roles="HR,人事总监,管理员" />
      <Button value="系统管理" kind="link" size="sm" action="navigate" href="/admin/users" data-min-level="90" />
    </Section>
    <Row>
      <Slot />
    </Row>
    <Section title="页脚">
      <Text i18n="footer.copyright" value="© 2026 KenvoySpace · 汇批呈览" />
    </Section>
  </Root>
</Layout>