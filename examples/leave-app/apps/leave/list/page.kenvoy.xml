<?xml version="1.0" encoding="UTF-8"?>
<Page>
  <Title>我的申请</Title>
  <Content>
    <Row>
      <Col span="4">
        <StatCard title="待审批" data="3" unit="单" color="warning" icon="ti ti-clock" />
      </Col>
      <Col span="4">
        <StatCard title="已批准" data="12" unit="单" color="success" icon="ti ti-check" />
      </Col>
      <Col span="4">
        <StatCard title="已驳回" data="1" unit="单" color="danger" icon="ti ti-x" />
      </Col>
    </Row>
    <Section title="我的申请">
      <Table model="请假单" pageSize="20">
        <Sort field="请假天数" order="desc" />
        <Column field="请假类型" label="类型" />
        <Column field="开始日期" label="开始" />
        <Column field="结束日期" label="结束" />
        <Column field="请假天数" label="天数" width="80" />
        <Column field="事由" label="事由" />
      </Table>
    </Section>
  </Content>
</Page>
