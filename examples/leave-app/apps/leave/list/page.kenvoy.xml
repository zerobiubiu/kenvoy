<?xml version="1.0" encoding="UTF-8"?>
<Page>
  <Import src="./publish.kenvoy.xml" as="权限配置" />
  <Title>我的申请 / 审批</Title>
  <Content>
    <Row>
      <Col span="4">
        <StatCard title="待我审批" data="0" unit="单" color="warning" icon="ti ti-clock" />
      </Col>
      <Col span="4">
        <StatCard title="已通过" data="0" unit="单" color="success" icon="ti ti-check" />
      </Col>
      <Col span="4">
        <StatCard title="已驳回" data="0" unit="单" color="danger" icon="ti ti-x" />
      </Col>
    </Row>
    <Section title="请假记录">
      <Table model="请假单" flow="请假审批流" detail="/leave/detail" pageSize="20">
        <Sort field="请假天数" order="desc" />
        <Column field="请假类型" label="类型" />
        <Column field="开始日期" label="开始" />
        <Column field="结束日期" label="结束" />
        <Column field="请假天数" label="天数" width="80" />
        <Column field="事由" label="事由" />
        <Column field="审批状态" label="状态" />
        <Column field="_actions" label="操作" />
      </Table>
    </Section>
  </Content>
</Page>