<?xml version="1.0" encoding="UTF-8"?>
<Models>
  <Model name="请假单">
    <Field name="申请人" type="user" label="申请人" />
    <Field name="部门" type="department" label="部门" />
    <Field name="请假天数" type="number" label="请假天数" />
    <Field name="请假类型" type="select" label="请假类型" options="年假,病假,事假,调休" />
    <Field name="开始日期" type="date" label="开始日期" />
    <Field name="结束日期" type="date" label="结束日期" />
    <Field name="事由" type="textarea" label="事由" />
    <Field name="附件" type="file" label="附件" />
    <!-- 流程字段：审批状态由 workflow `<Update>` 写入 -->
    <Field name="审批状态" type="text" label="审批状态" />
    <!-- 当前节点：runtime 由 instance 表维护，可由管理员编辑 -->
    <Field name="当前节点" type="text" label="当前节点" />
  </Model>
</Models>
