{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@kenvoy/client",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["@kenvoy/types"],
    "strict": true,
    "target": "ES2022"
  },
  "exclude": [
    "**/node_modules",
    "./.kenvoy",
    "./migrations",
    "./dist",
    "./data"
  ],
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "./**/*.js",
    "./**/*.jsx"
  ]
}
