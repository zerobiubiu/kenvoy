<?xml version="1.0" encoding="UTF-8"?>
<Page>
  <Title>填写请假单</Title>
  <Content>
    <Row>
      <Section title="请假信息">
        <Form model="请假单">
          <Field name="申请人" readonly="true" default="{{currentUser.name}}" />
          <Field name="请假类型" />
          <Field name="请假天数" suffix="天" />
          <Field name="事由" rows="4" />
        </Form>
      </Section>
    </Row>
  </Content>
</Page>
