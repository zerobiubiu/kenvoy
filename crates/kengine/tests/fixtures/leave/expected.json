{
  "version": "1.0",
  "project": {
    "name": "请假管理"
  },
  "models": {
    "请假单": {
      "name": "请假单",
      "fields": [
        {
          "name": "申请人",
          "type": "user",
          "label": "申请人",
          "required": false
        },
        {
          "name": "请假天数",
          "type": "number",
          "label": "请假天数",
          "required": false
        },
        {
          "name": "请假类型",
          "type": "select",
          "label": "请假类型",
          "options": [
            "年假",
            "病假",
            "事假",
            "调休"
          ],
          "required": false
        },
        {
          "name": "事由",
          "type": "textarea",
          "label": "事由",
          "required": false
        }
      ]
    }
  },
  "layouts": {
    "/": {
      "path": "/",
      "title": "Kenvoy 演示",
      "root": {
        "type": "Row",
        "props": {},
        "children": [
          {
            "type": "Section",
            "props": {
              "title": "导航"
            },
            "children": [
              {
                "type": "Text",
                "props": {
                  "value": "Kenvoy 请假管理"
                }
              }
            ]
          },
          {
            "type": "Slot"
          }
        ]
      }
    },
    "/leave": {
      "path": "/leave",
      "title": "请假管理",
      "root": {
        "type": "Row",
        "props": {},
        "children": [
          {
            "type": "Text",
            "props": {
              "value": "请假应用导航"
            }
          },
          {
            "type": "Slot"
          }
        ]
      }
    }
  },
  "pages": [
    {
      "path": "/leave/apply",
      "title": "填写请假单",
      "layoutChain": [
        "/",
        "/leave"
      ],
      "content": {
        "type": "Row",
        "props": {},
        "children": [
          {
            "type": "Section",
            "props": {
              "title": "请假信息"
            },
            "children": [
              {
                "type": "Form",
                "props": {
                  "model": "请假单",
                  "validations": [
                    {
                      "field": "请假天数",
                      "expr": "请假天数 > 0",
                      "message": "请假天数必须大于0"
                    },
                    {
                      "field": "事由",
                      "expr": "事由 非空",
                      "message": "请填写请假事由"
                    }
                  ]
                },
                "children": [
                  {
                    "type": "Field",
                    "props": {
                      "name": "申请人",
                      "readonly": true,
                      "required": false,
                      "default": "{{currentUser.name}}"
                    }
                  },
                  {
                    "type": "Field",
                    "props": {
                      "name": "请假类型",
                      "readonly": false,
                      "required": false
                    }
                  },
                  {
                    "type": "Field",
                    "props": {
                      "name": "请假天数",
                      "readonly": false,
                      "required": false,
                      "suffix": "天"
                    }
                  },
                  {
                    "type": "Field",
                    "props": {
                      "name": "事由",
                      "readonly": false,
                      "required": false,
                      "rows": 4
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "flows": [
        "请假审批流"
      ],
      "publish": {
        "allowRoles": [
          "普通员工",
          "部门主管",
          "管理员"
        ],
        "fields": [
          {
            "field": "附件",
            "readRoles": [
              "普通员工",
              "部门主管",
              "管理员"
            ],
            "writeRoles": [
              "普通员工",
              "管理员"
            ]
          }
        ],
        "roles": [
          {
            "name": "普通员工",
            "extends": null,
            "permissions": [
              "请假管理.申请.查看",
              "请假管理.申请.创建"
            ]
          },
          {
            "name": "部门主管",
            "extends": "普通员工",
            "permissions": [
              "请假管理.审批.操作"
            ]
          },
          {
            "name": "管理员",
            "extends": null,
            "permissions": [
              "*"
            ]
          }
        ],
        "dataFilters": [
          {
            "model": "请假单",
            "filters": [
              {
                "roles": [
                  "普通员工"
                ],
                "all": false,
                "conditions": [
                  {
                    "field": "申请人",
                    "op": "Eq",
                    "value": "{{currentUser.id}}"
                  }
                ]
              },
              {
                "roles": [
                  "部门主管",
                  "管理员"
                ],
                "all": true,
                "conditions": []
              }
            ]
          }
        ]
      }
    },
    {
      "path": "/leave/list",
      "title": "我的申请",
      "layoutChain": [
        "/",
        "/leave"
      ],
      "content": {
        "type": "Table",
        "props": {
          "model": "请假单",
          "pageSize": 20
        },
        "children": [
          {
            "type": "Column",
            "props": {
              "field": "请假类型",
              "label": "类型"
            }
          },
          {
            "type": "Column",
            "props": {
              "field": "请假天数",
              "label": "天数",
              "width": 80
            }
          }
        ]
      }
    }
  ],
  "flows": [
    {
      "name": "请假审批流",
      "trigger": "请假单.提交申请",
      "nodes": [
        {
          "name": "部门主管审批",
          "approver": "部门主管",
          "kind": "normal",
          "onApprove": [
            {
              "kind": "if",
              "expr": "请假天数 <= 3",
              "target": null,
              "users": [],
              "model": null,
              "field": null,
              "value": null,
              "to": null,
              "children": [
                {
                  "kind": "next",
                  "expr": null,
                  "target": "人事备案",
                  "users": [],
                  "model": null,
                  "field": null,
                  "value": null,
                  "to": null,
                  "children": []
                }
              ]
            },
            {
              "kind": "if",
              "expr": "请假天数 > 3",
              "target": null,
              "users": [],
              "model": null,
              "field": null,
              "value": null,
              "to": null,
              "children": [
                {
                  "kind": "next",
                  "expr": null,
                  "target": "人事总监审批",
                  "users": [],
                  "model": null,
                  "field": null,
                  "value": null,
                  "to": null,
                  "children": []
                }
              ]
            },
            {
              "kind": "notify",
              "expr": null,
              "target": null,
              "users": [
                "申请人"
              ],
              "model": null,
              "field": null,
              "value": null,
              "to": null,
              "children": []
            }
          ],
          "onReject": [
            {
              "kind": "back",
              "expr": null,
              "target": "发起人",
              "users": [],
              "model": null,
              "field": null,
              "value": null,
              "to": null,
              "children": []
            },
            {
              "kind": "notify",
              "expr": null,
              "target": null,
              "users": [
                "申请人"
              ],
              "model": null,
              "field": null,
              "value": null,
              "to": null,
              "children": []
            }
          ]
        },
        {
          "name": "人事总监审批",
          "approver": "角色.人事总监",
          "kind": "normal",
          "onApprove": [
            {
              "kind": "next",
              "expr": null,
              "target": "人事备案",
              "users": [],
              "model": null,
              "field": null,
              "value": null,
              "to": null,
              "children": []
            },
            {
              "kind": "notify",
              "expr": null,
              "target": null,
              "users": [
                "申请人",
                "部门主管"
              ],
              "model": null,
              "field": null,
              "value": null,
              "to": null,
              "children": []
            }
          ],
          "onReject": [
            {
              "kind": "back",
              "expr": null,
              "target": "部门主管审批",
              "users": [],
              "model": null,
              "field": null,
              "value": null,
              "to": null,
              "children": []
            },
            {
              "kind": "notify",
              "expr": null,
              "target": null,
              "users": [
                "申请人",
                "部门主管"
              ],
              "model": null,
              "field": null,
              "value": null,
              "to": null,
              "children": []
            }
          ]
        },
        {
          "name": "人事备案",
          "approver": "角色.HR",
          "kind": "notify",
          "onComplete": [
            {
              "kind": "update",
              "expr": null,
              "target": null,
              "users": [],
              "model": "请假单",
              "field": "审批状态",
              "value": "已通过",
              "to": null,
              "children": []
            },
            {
              "kind": "send_message",
              "expr": null,
              "target": null,
              "users": [],
              "model": null,
              "field": null,
              "value": "您的请假申请已通过",
              "to": "申请人",
              "children": []
            }
          ]
        }
      ]
    }
  ],
  "permissions": {
    "roles": [
      {
        "name": "普通员工",
        "extends": null,
        "permissions": [
          "请假管理.申请.查看",
          "请假管理.申请.创建"
        ]
      },
      {
        "name": "管理员",
        "extends": null,
        "permissions": [
          "*"
        ]
      },
      {
        "name": "部门主管",
        "extends": "普通员工",
        "permissions": [
          "请假管理.审批.操作"
        ]
      }
    ]
  },
  "components": {}
}
